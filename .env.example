# ── Meta / WhatsApp Cloud API ────────────────────────────────────────────────
# Permanent access token (create a System User in Meta Business Settings,
# assign it to your app with whatsapp_business_messaging permission).
WHATSAPP_ACCESS_TOKEN=EAAG...

# Any random string you invent. Paste the SAME value into the Meta app's
# webhook config ("Verify token" field).
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# App secret from Meta app dashboard (Settings -> Basic). Used to verify
# X-Hub-Signature-256 so only Meta can post to your webhook.
WHATSAPP_APP_SECRET=abc123...

# ── AI provider ──────────────────────────────────────────────────────────────
# "claude" (paid, best quality, no training on your data) or
# "gemini" (free tier available; free tier data may be used by Google to
# improve its products)
LLM_PROVIDER=claude

# If LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# If LLM_PROVIDER=gemini (key from aistudio.google.com/apikey):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Gmail ────────────────────────────────────────────────────────────────────
# Option A (running with files on disk): one OAuth token file per account,
# comma-separated:
GMAIL_TOKEN_FILES=./data/gmail_sales.json,./data/gmail_support.json,./data/gmail_accounts.json,./data/gmail_personal.json
# Option B (Render/Railway): instead of files, paste each token file's FULL
# JSON content into env vars named GMAIL_TOKEN_JSON_<NAME>, e.g.:
# GMAIL_TOKEN_JSON_SALES={"token": "...", "refresh_token": "...", ...}
# GMAIL_TOKEN_JSON_SUPPORT={...}
# GMAIL_TOKEN_JSON_ACCOUNTS={...}
# GMAIL_TOKEN_JSON_PERSONAL={...}
# Hub-inbox setup: if the other business addresses forward into one connected
# hub inbox, list YOUR own sending addresses here so your replies (BCC'd to the
# hub) are recognized as replies, not client mail:
OWNER_EMAILS=ai@thesolfactory.com,sales@thesolfactory.com,accounts@thesolfactory.com,bharat.bhushanjp@gmail.com
# Only mail matching this Gmail search query is scanned (tune to your needs)
GMAIL_QUERY=in:inbox newer_than:1d -category:{promotions social}

# ── App ──────────────────────────────────────────────────────────────────────
# Random string; the dashboard is only accessible with ?token=<this value>
DASHBOARD_TOKEN=change-me-too
# Postgres connection string (e.g. free Neon database). When set, all data is
# stored there permanently. When empty, a local SQLite file is used instead.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SQLite database location
DATABASE_PATH=./data/agent.db
# Where downloaded WhatsApp media (images, PDFs, voice notes) are stored
MEDIA_DIR=./data/media
# How often to scan all inboxes + WhatsApp and extract tasks (minutes)
SCAN_INTERVAL_MINUTES=60
TIMEZONE=Asia/Kolkata

# ── Notifications: daily digest + failure alerts ─────────────────────────────
# Emails a morning digest (new tasks, high-priority, skipped mails, backlog)
# and alerts you when messages get stuck in the queue.
# For Gmail: enable 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords and paste it as SMTP_PASS.
# Leave empty to disable email (digest still viewable at /digest?token=...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
NOTIFY_TO=you@company.com
# Hour of day (in TIMEZONE) to send the daily digest
DIGEST_HOUR=8

# ── Morning WhatsApp update (9AM task count + agent health) ──────────────────
# phone_number_id from Meta app dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Your personal WhatsApp number: country code + number, no + (e.g. 9198xxxxxxxx)
WA_NOTIFY_TO=
# Optional: approved template name for messages outside the 24h window.
# Create in Meta WhatsApp Manager with body like:
#   "Good morning! {{1}} tasks open ({{2}} high priority), {{3}} new since yesterday."
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en
# Hour of day (in TIMEZONE) for the WhatsApp update
WA_DIGEST_HOUR=9

# ── Department credentials ───────────────────────────────────────────────────
# Each department opens the dashboard with its own token and sees ONLY its
# tasks. Admin (DASHBOARD_TOKEN) sees everything + Mails/WhatsApp/Skipped.
# Format: department:token, comma separated.
DEPT_TOKENS=logistics:CHANGE-ME-1,production:CHANGE-ME-2,accounts:CHANGE-ME-3,design:CHANGE-ME-4

# ── Email login (RBAC) ───────────────────────────────────────────────────────
# Long random string that signs login sessions (keep secret).
SECRET_KEY=CHANGE-ME-to-a-long-random-string
# The first admin account, auto-created at startup if no users exist.
# Sign in with it, then add everyone on the Users page.
INIT_ADMIN_EMAIL=braj@thesolfactory.com
INIT_ADMIN_PASSWORD=CHANGE-ME-strong-password

# ── Production sheet sync (connects the CXO dashboards' Google Sheet) ────────
# Paste the SAME values you use in the dashboard's connect panel:
SHEETS_API_KEY=AIza...
PROD_SHEET_ID=https://docs.google.com/spreadsheets/d/....  (or just the ID)
PROD_SHEET_TAB=Sheet1
# How often to sync (minutes) and how close to ship-ready counts as at-risk (days)
SHEET_SYNC_MINUTES=60
SHEET_RISK_DAYS=2
